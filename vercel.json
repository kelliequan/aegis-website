{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/verification",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/verification.html",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/escrow",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/escrow.html",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/trust-score",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/trust-score.html",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/tenants",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/tenants.html",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/agents",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/agents.html",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/landlords",
      "destination": "/how-it-works",
      "permanent": false
    },
    {
      "source": "/landlords.html",
      "destination": "/how-it-works",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/p/:code",
      "destination": "/api/share?t=p&c=:code"
    },
    {
      "source": "/u/:username",
      "destination": "/api/share?t=u&c=:username"
    },
    {
      "source": "/:username/property/:code",
      "destination": "/api/share?t=p&c=:code"
    },
    {
      "source": "/:username",
      "destination": "/api/share?t=u&c=:username"
    }
  ]
}
